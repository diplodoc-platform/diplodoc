{
  "name": "@diplodoc/diplodoc",
  "version": "1.0.0",
  "description": "Meta package for Diplodoc platform development",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "devops/*",
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "watch": "scripts/watch.js",
    "build": "nx build @diplodoc/testpack",
    "test": "nx test @diplodoc/testpack",
    "reset": "npx zx scripts/reset.js",
    "pulse": "npx zx scripts/pulse.js",
    "deps-graph": "node scripts/deps-graph.js",
    "deps-graph:check": "node scripts/deps-graph.js --check",
    "test:scripts": "node --test \"scripts/**/*.test.js\"",
    "sync-release-train-repos": "node scripts/sync-release-train-repos.js",
    "sync-release-train-repos:check": "node scripts/sync-release-train-repos.js --check",
    "release-train:graph": "node scripts/deps-graph.js",
    "deps": "npx zx scripts/deps.js",
    "bootstrap": "scripts/bootstrap.sh",
    "codespaces": "scripts/codespaces.sh",
    "git:init": "scripts/git-init.sh",
    "git:apply": "scripts/git-apply.sh",
    "git:head": "scripts/git-apply.sh master --unsafe",
    "analyze-deps": "scripts/node-version-checker.sh",
    "check-submodules": "scripts/check-submodules.sh",
    "add-submodules": "scripts/add-submodules.sh",
    "typecheck:native": "scripts/typecheck-native.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diplodoc-platform/diplodoc.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/diplodoc-platform/diplodoc/issues"
  },
  "homepage": "https://github.com/diplodoc-platform/diplodoc#readme",
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "nx": "^20.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zx": "^8.8.5"
  },
  "overrides": {
    "@gravity-ui/markdown-editor": {
      "@diplodoc/latex-extension": "^2.0.1"
    },
    "@gravity-ui/page-constructor": "^8.14.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.17",
    "typescript": "6.0.3"
  }
}
